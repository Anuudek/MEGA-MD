FROM cloudron/base:5.0.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends apt-utils curl ffmpeg python3 build-essential git && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Standalone yt-dlp binary (self-contained, no pip needed) - backs .play/.video/.song/.spotify
# since the old upstream third-party download API they relied on (api.qasimdev.dpdns.org) is dead.
RUN curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod +x /usr/local/bin/yt-dlp

# yt-dlp needs a JS runtime to solve YouTube's current signature/PO-token challenges -
# without it, extraction silently degrades or fails ("Sign in to confirm you're not a bot").
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh -s -- -y

RUN mkdir -p /app/code /app/pkg
WORKDIR /app/code

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --loglevel=error --no-fund

COPY . /app/code
COPY start.sh /app/pkg/start.sh
RUN chmod +x /app/pkg/start.sh && \
    chown -R cloudron:cloudron /app/code

CMD ["/app/pkg/start.sh"]
